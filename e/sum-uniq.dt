--  Here, I prove it myself.

theorem sum-uniq-commutes-manual : ∀ (n1, n2 : ℕ) : ∃ (n3 : ℕ) : Sum(n1, n2, n3) ∧ Sum(n2, n1, n3)

N+0=N : ∀ (N : ℕ) : Sum(N, Zero, N)  by theorem n+0=n

∀ (n1 : ℕ) (n2 : ℕ) : ∃ (n3 : ℕ) : Sum(n1, n2, n3) ∧ Sum(n2, n1, n3)  by induction :

  case Zero ->
    |
    |--------------------------------------------------------------------------
    | -- goal = ∀ (n2 : ℕ) : ∃ (n3 : ℕ) : Sum(Zero, n2, n3) ∧ Sum(n2, Zero, n3)
    |
    | 1 : | for any (N2 : ℕ)
    |     |--------------------------------------------------------------------
    |     |
    |     | 2 : Sum(Zero, N2, N2)  by rule sum-zero
    |     | 3 : Sum(N2, Zero, N2)  by rule ∀-elim on N+0=N
    |     | 4 : Sum(Zero, N2, N2) ∧ Sum(N2, Zero, N2)  by rule ∧-intro on 2,3
    |     | 5 : ∃ (n3 : ℕ) : Sum(Zero, N2, n3) ∧ Sum(N2, Zero, n3)  by rule ∃-intro on 4
    |
    | 2 : ∀ (n2 : ℕ) : ∃ (n3 : ℕ) : Sum(Zero, n2, n3) ∧ Sum(n2, Zero, n3)  by rule ∀-intro on 1

  case Suc(m) ->
    | ind-hyp : ∀ (n2 : ℕ) : ∃ (n3 : ℕ) : Sum(m, n2, n3) ∧ Sum(n2, m, n3)
    |--------------------------------------------------------------------------
    | -- goal = ∀ (n2 : ℕ) : ∃ (n3 : ℕ) : Sum(Suc(m), n2, n3) ∧ Sum(n2, Suc(m), n3)
    |
    | 1 : | for any (N2' : ℕ)
    |     |--------------------------------------------------------------------
    |     |
    |     | ∃ (n3 : ℕ) : Sum(Suc(m), N2', n3) ∧ Sum(N2', Suc(m), n3)  by case analysis on N2' :
    |     |
    |     |   case Zero ->
    |     |     |
    |     |     |--------------------------------------------------------------
    |     |     |
    |     |     | 1 : Sum(Suc(m), Zero, Suc(m))  by rule ∀-elim on N+0=N
    |     |     | 2 : Sum(Zero, Suc(m), Suc(m))  by rule sum-zero
    |     |     | 3 : Sum(Suc(m), Zero, Suc(m)) ∧ Sum(Zero, Suc(m), Suc(m))  by rule ∧-intro on 1, 2
    |     |     | 4 : ∃ (n3 : ℕ) : Sum(Suc(m), Zero, n3) ∧ Sum(Zero, Suc(m), n3)  by rule ∃-intro on 3
    |     |
    |     |   case Suc(m') ->
    |     |     |
    |     |     |--------------------------------------------------------------
    |     |     |
    |     |     | 1 : ∃ (n3 : ℕ) : Sum(m, Suc(m'), n3) ∧ Sum(Suc(m'), m, n3)  by rule ∀-elim on ind-hyp
    |     |     | 2 : | p : Sum(m, Suc(m'), n3') ∧ Sum(Suc(m'), m, n3') for some (n3' : ℕ)
    |     |     |     |--------------------------------------------------------
    |     |     |     |
    |     |     |     | 33 : Sum(m, Suc(m'), n3')  by rule ∧-elim on p
    |     |     |     | 4 : Sum(Suc(m'), m, n3')  by rule ∧-elim on p
    |     |     |     | 5 : Sum(Suc(m), Suc(m'), Suc(n3'))  by rule sum-suc on 33
    |     |     |     | f2 : ∀ (N1 : ℕ) (N2 : ℕ) (n3' : ℕ) : Sum(N1, N2, n3') ==> Sum(N1, Suc(N2), Suc(n3')) by theorem sum-s-rhs
    |     |     |     | f1 : Sum(Suc(m'), m, n3') ==> Sum(Suc(m'), Suc(m), Suc(n3'))  by rule ∀-elim on f2
    |     |     |     | 6 : Sum(Suc(m'), Suc(m), Suc(n3'))  by rule ==>-elim on f1, 4
    |     |     |     | 7 : Sum(Suc(m), Suc(m'), Suc(n3')) ∧ Sum(Suc(m'), Suc(m), Suc(n3'))  by rule ∧-intro on 5, 6
    |     |     |     | 8 : ∃ (n3 : ℕ) : Sum(Suc(m), Suc(m'), n3) ∧ Sum(Suc(m'), Suc(m), n3)  by rule ∃-intro on 7
    |     |     |
    |     |     | 9 : ∃ (n3 : ℕ) : Sum(Suc(m), Suc(m'), n3) ∧ Sum(Suc(m'), Suc(m), n3)  by rule ∃-elim on 1, 2
    |
    | 2 : ∀ (n2 : ℕ) : ∃ (n3 : ℕ) : Sum(Suc(m), n2, n3) ∧ Sum(n2, Suc(m), n3)  by rule ∀-intro on 1



